  'https://jszyapi.com/api.php/provide/vod',             // 极速资源（~2.2s）
  'https://jyzyapi.com/provide/vod/',                    // 金鹰资源（~1.5s，特例路径）
  'https://cj.ffzyapi.com/api.php/provide/vod',          // 非凡资源（~1.9s）
  'https://api.apibdzy.com/api.php/provide/vod',         // 百度资源（~3.3s）
