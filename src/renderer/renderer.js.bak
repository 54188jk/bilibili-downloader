];

function movieConfig() {
  let base = localStorage.getItem('movieBase') || '';
  let parser = localStorage.getItem('movieParser') || '';
  if (!base) base = MOVIE_BASE_PRESETS[0];
  if (!parser) parser = MOVIE_PARSER_PRESETS[0];
  const probeTimeout = parseInt(localStorage.getItem('movieProbeTimeout') || '0', 10) || 8000;
  return { base, parser, probeTimeout };
}

function refreshMovieConfig() {
  const { base, parser, probeTimeout } = movieConfig();
  if (els.movieBaseInput) els.movieBaseInput.value = base;
  if (els.movieParserInput) els.movieParserInput.value = parser;
  if (els.movieProbeTimeoutInput) els.movieProbeTimeoutInput.value = probeTimeout / 1000;
  renderMoviePresets();
}

function renderMoviePresets() {
  if (els.movieBasePresets) {
    els.movieBasePresets.innerHTML = '';
    MOVIE_BASE_PRESETS.forEach(u => {
      const b = document.createElement('button');
      b.className = 'preset-chip';
      b.textContent = u.replace(/^https?:\/\//, '');
      b.addEventListener('click', () => { els.movieBaseInput.value = u; });
      els.movieBasePresets.appendChild(b);
    });
  }
  if (els.movieParserPresets) {
    els.movieParserPresets.innerHTML = '';
    MOVIE_PARSER_PRESETS.forEach(u => {
      const b = document.createElement('button');
      b.className = 'preset-chip';
      b.textContent = u.replace(/^https?:\/\//, '');
      b.addEventListener('click', () => { els.movieParserInput.value = u; });
      els.movieParserPresets.appendChild(b);
    });
  }
}

function parseVodPlayUrl(str) {
  if (!str) return [];
  const out = [];
  String(str).split('#').forEach(g => {
    if (!g) return;
    const i = g.lastIndexOf('$');
    let name = g, url = g;
    if (i >= 0) { name = g.slice(0, i); url = g.slice(i + 1); }
    if (url) out.push({ name: name || ('源' + (out.length + 1)), url: url.trim() });
  });
  return out;
}

// ===== 搜索源健康缓存 + 搜索结果缓存（加速后续搜索） =====
const MOVIE_SRC_HEALTH_KEY = 'movieSrcHealth';
const MOVIE_SEARCH_CACHE_KEY = 'movieSearchCache';
const MOVIE_DETAIL_CACHE_KEY = 'movieDetailCache';
const SEARCH_CACHE_TTL = 5 * 60 * 1000;  // 搜索结果缓存 5 分钟
const DETAIL_CACHE_TTL = 10 * 60 * 1000;  // 详情缓存 10 分钟

// 搜索结果缓存：避免重复搜索同一关键词
function loadSearchCache() {
  try { return JSON.parse(localStorage.getItem(MOVIE_SEARCH_CACHE_KEY) || '{}') || {}; } catch (e) { return {}; }
}
function saveSearchCache(cache) {
  try { localStorage.setItem(MOVIE_SEARCH_CACHE_KEY, JSON.stringify(cache)); } catch (e) {}
}
function getCachedSearch(kw) {
  const cache = loadSearchCache();
  const entry = cache[kw];
  if (entry && Date.now() - (entry.ts || 0) < SEARCH_CACHE_TTL) {
    return entry.results;
  }
  return null;
}
function setCachedSearch(kw, results) {
  const cache = loadSearchCache();
  // 限制缓存条目数
  const keys = Object.keys(cache);
  if (keys.length > 30) {
    const sorted = keys.sort((a, b) => (cache[a].ts || 0) - (cache[b].ts || 0));
    sorted.slice(0, keys.length - 25).forEach(k => delete cache[k]);
  }
  cache[kw] = { results, ts: Date.now() };
  saveSearchCache(cache);
}

// 详情缓存：避免重复请求同一影片详情
function loadDetailCache() {
  try { return JSON.parse(localStorage.getItem(MOVIE_DETAIL_CACHE_KEY) || '{}') || {}; } catch (e) { return {}; }
}
function saveDetailCache(cache) {
  try { localStorage.setItem(MOVIE_DETAIL_CACHE_KEY, JSON.stringify(cache)); } catch (e) {}
}
function getCachedDetail(base, id) {
  const cache = loadDetailCache();
  const key = base + '|' + id;
  const entry = cache[key];
  if (entry && Date.now() - (entry.ts || 0) < DETAIL_CACHE_TTL) {
    return entry.data;
  }
  return null;
}
function setCachedDetail(base, id, data) {
  const cache = loadDetailCache();
  const keys = Object.keys(cache);
  if (keys.length > 50) {
    const sorted = keys.sort((a, b) => (cache[a].ts || 0) - (cache[b].ts || 0));
    sorted.slice(0, keys.length - 40).forEach(k => delete cache[k]);
  }
  cache[base + '|' + id] = { data, ts: Date.now() };
  saveDetailCache(cache);
}

function loadMovieSrcHealth() {
  try { return JSON.parse(localStorage.getItem(MOVIE_SRC_HEALTH_KEY) || '{}') || {}; }
  catch (e) { return {}; }
}
function isMovieSrcDead(src, health, ts) {
  const e = health[src];
  if (!e) return false;
  const ttl = 3 * 60 * 1000;   // 死源 3 分钟后恢复尝试（原 10 分钟太长）
  return e.dead && ts - (e.ts || 0) < ttl;
}
function markMovieSrcOk(src, health, speed) {
  const h = health || loadMovieSrcHealth();
  h[src] = { dead: false, ts: Date.now(), speed: speed || (h[src] && h[src].speed) || 5000 };
  localStorage.setItem(MOVIE_SRC_HEALTH_KEY, JSON.stringify(h));
}
function markMovieSrcDead(src, health) {
  const h = health || loadMovieSrcHealth();
  h[src] = { dead: true, ts: Date.now(), speed: (h[src] && h[src].speed) || 5000 };
  localStorage.setItem(MOVIE_SRC_HEALTH_KEY, JSON.stringify(h));
}
function cleanupMovieSrcHealth(health) {
  const ts = Date.now();
  const ttl = 15 * 60 * 1000;
  let dirty = false;
  Object.keys(health).forEach(k => {
    if (ts - (health[k].ts || 0) > ttl) { delete health[k]; dirty = true; }
  });
  if (dirty) localStorage.setItem(MOVIE_SRC_HEALTH_KEY, JSON.stringify(health));
}

// 从最快的 N 个源中随机选一个（速度排序 + 随机轮换，避免总卡同一个源）
function pickFastSource(sources, health, count) {
  count = count || 3;
  const nowMs = Date.now();
  const alive = sources.filter(s => s && /^https?:\/\//i.test(s) && !isMovieSrcDead(s, health, nowMs));
  if (!alive.length) return sources[0] || null;
  alive.sort((a, b) => {
    const sa = (health[a] && health[a].speed) || 3000;
    const sb = (health[b] && health[b].speed) || 3000;
    return sa - sb;
  });
  const pool = alive.slice(0, Math.min(count, alive.length));
  return pool[Math.floor(Math.random() * pool.length)];
}

// ===== 启动时自动检测所有影视源可用性 =====
let _startupHealthRan = false;
async function startupMovieHealthCheck() {
  if (_startupHealthRan) return;
  _startupHealthRan = true;
  const health = loadMovieSrcHealth();
  const nowMs = Date.now();
  // 跳过近期已检测过的源（5分钟内）
  const staleTtl = 5 * 60 * 1000;
  const toCheck = MOVIE_BASE_PRESETS.filter(s => {
    if (!s || !/^https?:\/\//i.test(s)) return false;
    const e = health[s];
    if (e && (nowMs - (e.ts || 0)) < staleTtl) return false; // 近期已检测，跳过
    return true;
  });
  if (!toCheck.length) return; // 全部新鲜，无需检测

  let cursor = 0;
  async function worker() {
    while (cursor < toCheck.length) {
      const src = toCheck[cursor++];
      const t0 = Date.now();
      try {
        await window.api.movieSearch(src, 'test', 1, 3000);
        const elapsed = Date.now() - t0;
        markMovieSrcOk(src, health, elapsed);
      } catch (_) {
        markMovieSrcDead(src, health);
      }
    }
  }
  await Promise.all(Array.from({ length: Math.min(10, toCheck.length) }, worker));
  localStorage.setItem(MOVIE_SRC_HEALTH_KEY, JSON.stringify(health));
  cleanupMovieSrcHealth(health);
}

async function doMovieSearch() {
  const kw = els.movieSearchInput.value.trim();
  const { base: curBase, parser } = movieConfig();
  if (!kw) { toast('请输入片名', 'error'); return; }

  // ── 优先走本地影视 API（多源聚合 + 磁盘缓存，秒回）──
  // 服务不可用 / 超时 / 无结果时自动回退到下方多源并发直连
  const quickBtnLabel = els.movieSearchBtn?.querySelector('.btn-label');
  els.movieSearchBtn.disabled = true;
  if (quickBtnLabel) quickBtnLabel.textContent = '搜索中…';
  let quickHit = false;
  try {
    // 本地聚合最多等 5s（优化后冷首搜约 2-3s，缓存命中约 3ms）
    const sv = await Promise.race([
      window.api.movieServerApi('/api/search', { wd: kw, pg: 1 }),
      new Promise((_, rej) => setTimeout(() => rej(new Error('本地聚合超时')), 5000)),
    ]);
    if (sv && sv.ok && sv.data && sv.data.code === 0 && Array.isArray(sv.data.list) && sv.data.list.length) {
      const list = sv.data.list;
      setCachedSearch(kw, list);
      lastAggregation = list;
      renderMovieResults(list);
      quickHit = true;
      if (sv.data.cached) toast(`本地API缓存：${list.length} 条`, 'success', 2000);
      else toast(`聚合 ${(sv.data.order || []).length} 个源，共 ${list.length} 条结果（${Math.round((sv.data.elapsed || 0) / 1000)}s）`, 'success', 3000);
    }
  } catch (e) { /* 服务不可用，继续走直连 */ }
  els.movieSearchBtn.disabled = false;
  if (quickBtnLabel) quickBtnLabel.textContent = '搜索';
  if (quickHit) return;

  // 搜索结果缓存：相同关键词 5 分钟内直接返回缓存
  const cached = getCachedSearch(kw);
  if (cached && cached.length) {
    toast(`使用缓存结果：${cached.length} 条（${Math.round(SEARCH_CACHE_TTL / 60000)} 分钟内有效）`, 'info', 2000);
    lastAggregation = cached;
    renderMovieResults(cached);
    return;
  }

  // 多源聚合搜索：遍历当前源 + 全部预设源，并发搜索，合并去重，确保内容完整
  // 已死源健康缓存放后（但仍会尝试），整体并发上限 10，单源 2s 超时，提速明显
  const sources = [curBase, ...MOVIE_BASE_PRESETS.filter(b => b && b !== curBase)];
  const sourceList = sources.filter(s => /^https?:\/\//i.test(s));
  if (!sourceList.length) { toast('请先在「数据源」中填写有效的搜索源地址', 'error'); return; }

  const health = loadMovieSrcHealth();
  const nowMs = Date.now();
  // 速度排序 + 随机轮换：从最快的 3 个中随机选，避免总卡同一个源
  const ordered = sourceList.slice().sort((a, b) => {
    const ha = isMovieSrcDead(a, health, nowMs) ? 1 : 0;
    const hb = isMovieSrcDead(b, health, nowMs) ? 1 : 0;
    if (ha !== hb) return ha - hb;
    const sa = (health[a] && health[a].speed) || 3000;
    const sb = (health[b] && health[b].speed) || 3000;
    return sa - sb;
  });
  // 首选源从最快 3 个中随机挑（同源搜索保持一致，不同搜索自动轮换）
  const fastPool = ordered.filter(s => !isMovieSrcDead(s, health, nowMs)).slice(0, 3);
  if (fastPool.length > 1) {
    const pick = fastPool[Math.floor(Math.random() * fastPool.length)];
    const idx = ordered.indexOf(pick);
    if (idx > 0) { ordered.splice(idx, 1); ordered.unshift(pick); }
  }

  // 非阻塞式搜索：不盖遮罩，结果边出边渲染、可即时点击
  const searchBtnLabel = els.movieSearchBtn?.querySelector('.btn-label');
  els.movieSearchBtn.disabled = true;
  if (searchBtnLabel) searchBtnLabel.textContent = '搜索中…';
  const results = [];        // 聚合结果（已去重）
  const seen = new Set();    // 去重 key（片名 + 年份）
  let okSources = 0;
  let firstOkSource = null;
  let renderScheduled = false; // 防止过于频繁的重绘

  // 并发小池：每个源独立超时，不互相阻塞；并发数 12，1.5s 超时，够 5 个源结果后提前退出
  let cursor = 0;
  let rendererHitCount = 0;
  let rendererEarlyExit = false;
  async function worker() {
    while (cursor < ordered.length && !rendererEarlyExit) {
      const src = ordered[cursor++];
      const t0 = Date.now();
      try {
        const r = await window.api.movieSearch(src, kw, 1, 1500);
        const elapsed = Date.now() - t0;
        if (r.ok && r.data && Array.isArray(r.data.list)) {
          if (r.data.list.length > 0 && !firstOkSource) firstOkSource = src;
          const list = r.data.list.map(it => ({ ...it, _src: src }));
          let newCount = 0;
          const srcHost = src.replace(/^https?:\/\//, '').split('/')[0];
          list.forEach(it => {
            // 精确去重：同名+同年跳过
            const exactKey = ((it.vod_name || '') + '|' + (it.vod_year || '')).trim();
            if (seen.has(exactKey)) return;
            // 同源模糊去重：同一 CMS 源返回的同名片（忽略年份微差）也跳过
            const normKey = normMovieName(it.vod_name) + '|' + srcHost;
            if (seen.has(normKey)) return;
            seen.add(exactKey);
            seen.add(normKey);
            results.push(it);
            newCount++;
          });
          okSources++;
          rendererHitCount++;
          markMovieSrcOk(src, health, elapsed);
          // 早期渲染：每收到新结果时立即更新 UI，不等全部完成
          if (newCount > 0 && !renderScheduled) {
            renderScheduled = true;
            requestAnimationFrame(() => {
              lastAggregation = results.slice();
              renderMovieResults(results);
              renderScheduled = false;
            });
          }
          // 收到 5 个源结果后提前退出（不再等慢源）
          if (rendererHitCount >= 5) rendererEarlyExit = true;
        }
      } catch (e) {
        // 网络错误 / 超时，跳过该源，并记为死源加速后续搜索
        markMovieSrcDead(src, health);
      }
    }
  }
  // 并发 12 个源加速搜索；为避免等待过久，只搜索前 15 个最可靠的源
  const searchLimit = Math.min(15, ordered.length);
  await Promise.all(Array.from({ length: Math.min(12, searchLimit) }, worker));
  // 收尾：清理过期的健康记录
  cleanupMovieSrcHealth(health);
  els.movieSearchBtn.disabled = false;
  if (searchBtnLabel) searchBtnLabel.textContent = '搜索';

  if (!results.length) {
    toast(okSources ? '未找到相关影视' : '搜索源暂不可用，稍后重试', 'error', 5000);
    els.movieResult.innerHTML = '<div class="empty-state"><p>没有找到相关影视</p><span class="empty-sub">换个关键词试试</span></div>';
    return;
  }

  // 缓存搜索结果
  setCachedSearch(kw, results);

  // 记录第一个可用源为当前源，便于详情默认使用
  if (firstOkSource && firstOkSource !== curBase) {
    localStorage.setItem('movieBase', firstOkSource);
    if (els.movieBaseInput) els.movieBaseInput.value = firstOkSource;
  }
  if (okSources > 1) toast(`搜索了 ${okSources} 个源，共 ${results.length} 条结果`, 'success', 3000);

  lastAggregation = results;
  renderMovieResults(results);
}

// 影视名归一化：去掉常见前后缀/标点/空格，用于去重比较
function normMovieName(s) {
  return (s || '').trim().toLowerCase()
    .replace(/[\s　·・·/,，。！!？?：:；;""''「」【】\[\]()（）《》<>\-—_~～、]+/g, '')
    .replace(/^(第[\d一二三四五六七八九十百千]+季|S\d+|Season\s*\d+)/i, '')  // 去掉开头季号
    .replace(/(第[\d一二三四五六七八九十百千]+季|S\d+|Season\s*\d+)$/i, '')  // 去掉结尾季号
    .replace(/^(大电影|剧场版|特别篇|番外篇|OVA|OAD)/i, '')
    .replace(/(大电影|剧场版|特别篇|番外篇|OVA|OAD)$/i, '');
}

function renderMovieResults(list) {
  // 去重合并：同名+同年影片合并为一条，保留封面最好的，其余存入 _altBases
  // 同一源的同名片也合并（CMS 同一内容可能返回多条）
  const groupMap = new Map();
  list.forEach(item => {
    const name = normMovieName(item.vod_name);
    const year = (item.vod_year || '').trim();
    if (!name) return;
    // 用 name+year 作 key，防止同名不同年的影片被错误合并
    const key = year ? (name + '|' + year) : name;
    if (!groupMap.has(key)) groupMap.set(key, []);
    groupMap.get(key).push(item);
  });
  // 第二轮：同一源的同名（忽略年份差异）也合并——CMS 有时同内容年份不一致
  const hostMap = new Map(); // key: normName + '|' + host -> [groupKey...]
  for (const [key, items] of groupMap) {
    if (items.length <= 1) continue;
    const host = (items[0]._src || '').replace(/^https?:\/\//, '').split('/')[0];
    const normName = normMovieName(items[0].vod_name);
    const hKey = normName + '|' + host;
    if (hostMap.has(hKey)) {
      const existingKey = hostMap.get(hKey);
      const existingItems = groupMap.get(existingKey);
      if (existingItems && existingItems !== items) {
        existingItems.push(...items);
        groupMap.delete(key);
      }
    } else {
      hostMap.set(hKey, key);
    }
  }

  const merged = [];
  for (const [, items] of groupMap) {
    if (items.length === 1) { merged.push(items[0]); continue; }
    // 排序：有封面优先 > 集数多优先 > 备注含"正片"优先
    items.sort((a, b) => {
      const pa = (a.vod_pic || '').length > 5 ? 1 : 0;
      const pb = (b.vod_pic || '').length > 5 ? 1 : 0;
      if (pb !== pa) return pb - pa;
      const ra = parseInt((a.vod_remarks || '').match(/\d+/)?.[0] || '0');
      const rb = parseInt((b.vod_remarks || '').match(/\d+/)?.[0] || '0');
      if (rb !== ra) return rb - ra;
      const sa = (a.vod_remarks || '').includes('正片') ? 1 : 0;
      const sb = (b.vod_remarks || '').includes('正片') ? 1 : 0;
      return sb - sa;
    });
    const best = items[0];
    // 合并所有源到 _altBases，方便详情失败时换源
    best._altBases = items.map(it => ({ base: it._src, vodId: it.vod_id }));
    merged.push(best);
  }

  els.movieResult.innerHTML = '';
  const header = document.createElement('div');
  header.className = 'movie-count-hint';
  header.textContent = `${merged.length} 条结果`;
  els.movieResult.appendChild(header);
  merged.forEach(item => {
    const card = document.createElement('div');
    card.className = 'movie-card';
    card.dataset.base = item._src || '';
    card.dataset.vodId = item.vod_id != null ? item.vod_id : '';
    card.dataset.altBases = JSON.stringify(item._altBases || []);
    const pic = (item.vod_pic || '').replace(/^http:\/\//i, 'https://');
    const name = item.vod_name || '未知';
    const remarks = item.vod_remarks || '';
    const year = item.vod_year || '';
    const srcHost = (item._src || '').replace(/^https?:\/\//, '').split('/')[0];
    const srcCount = (item._altBases || []).length + 1;
    card.innerHTML = `
      <div class="movie-cover-wrap">
        ${pic ? `<img class="movie-cover" src="${escapeHtml(pic)}" alt="" onerror="this.style.display='none';this.nextElementSibling&&(this.nextElementSibling.style.display='flex')" />` : ''}
        <div class="movie-cover movie-cover-fallback" ${pic ? 'style="display:none"' : ''}>${escapeHtml(name.slice(0, 1))}</div>
        ${srcHost ? `<span class="movie-source-tag">${escapeHtml(srcHost)}${srcCount > 1 ? ' +' + (srcCount - 1) : ''}</span>` : ''}
      </div>
      <div class="movie-card-name">${escapeHtml(name)}</div>
      <div class="movie-card-sub">${escapeHtml((year ? year + ' · ' : '') + remarks)}</div>
    `;
    const base = card.dataset.base;
    const vodId = card.dataset.vodId;
    const altBases = JSON.parse(card.dataset.altBases || '[]');
    card.addEventListener('click', () => {
      const allSources = [{ base, vodId }, ...altBases];
      if (allSources.length <= 1) {
        doMovieDetail(base, vodId);
      } else {
        autoSelectBestSource(item, allSources);
      }
    });
    els.movieResult.appendChild(card);
  });
}

// 自动选择最佳源：直接用主源（排序最优），doMovieDetail 内部已有自动换源兜底
async function autoSelectBestSource(item, sources) {
  doMovieDetail(sources[0].base, sources[0].vodId);
}

async function doMovieDetail(base, id) {
  const src = base || movieConfig().base;
  if (id == null) { toast('该条记录缺少片源 ID，无法播放', 'error'); return; }

  // 详情换源兜底：原源失败时，尝试聚合结果中同名影片的其他源
  // 带缓存：10 分钟内相同源+ID 直接返回缓存，避免重复请求
  async function fetchDetail(s, vodId) {
    const cached = getCachedDetail(s, vodId);
    if (cached) return cached;
    try {
      const rr = await window.api.movieDetail(s, vodId);
      if (rr.ok && rr.data && (rr.data.vod_play_url || rr.data.vod_play_from)) {
        setCachedDetail(s, vodId, rr.data);
        return rr.data;
      }
      return null;
    } catch (e) {
      return null;
    }
  }

  showLoading('加载播放信息…');
  let d = null, usedSrc = src;
  try {
    d = await fetchDetail(src, id);
    if (!d) {
      // 尝试 _altBases（去重合并时记录的同名片源）——并行请求，谁先返回用谁
      const card = els.movieResult.querySelector(`[data-vod-id="${id}"][data-base="${CSS.escape(src)}"]`);
      const altBases = (() => { try { return JSON.parse(card?.dataset?.altBases || '[]'); } catch(e) { return []; } })();
      const others = altBases.filter(ab => ab.base !== src);
      if (others.length) {
        const results = await Promise.all(others.map(ab => fetchDetail(ab.base, ab.vodId)));
        for (let i = 0; i < results.length; i++) {
          if (results[i]) { d = results[i]; usedSrc = others[i].base; break; }
        }
      }
      // 再从 lastAggregation 兜底
      if (!d) {
        const cur = lastAggregation.find(it => String(it.vod_id) === String(id)) || lastAggregation.find(it =>
          it._src === src);
        if ((cur && cur.vod_name) || lastAggregation.length) {
          const name = (cur && cur.vod_name) ? cur.vod_name
            : (lastAggregation.find(it => String(it.vod_id) === String(id)) || {}).vod_name;
          const alt = lastAggregation.filter(it => it.vod_name === name && it._src !== src);
          for (const a of alt) {
            const cand = await fetchDetail(a._src, a.vod_id);
            if (cand) { d = cand; usedSrc = a._src; break; }
          }
        }
      }
    }
  } finally {
    hideLoading();
  }
  if (!d) { toast('该片源暂不可用，试试「换一条解析」', 'error', 4000); return; }
  if (usedSrc !== src) toast('已切换到其他播放源', 'info', 2500);
  els.movieDetailPic.src = (d.vod_pic || '').replace(/^http:\/\//i, 'https://');
  els.movieDetailName.textContent = d.vod_name || '未知';
  const sub = [d.vod_year, d.vod_remarks, d.vod_director, d.vod_area].filter(Boolean).join(' · ');
  els.movieDetailSub.textContent = sub;
  els.movieDetailDesc.textContent = (d.vod_content || d.vod_blurb || '').replace(/<[^>]+>/g, '').slice(0, 300);
  // 多线路选择：CMS API 可能返回多组播放地址（$$$分隔），选择集数最多/最完整的线路
  let eps = [];
  let bestSourceName = '';
  const playUrls = (d.vod_play_url || '').split('$$$');
  const sourceNames = (d.vod_play_from || '').split('$$$');
  if (playUrls.length > 1) {
    // 多线路：选集数最多的一条
    let maxCount = 0;
    playUrls.forEach((urlGroup, idx) => {
      const parsed = parseVodPlayUrl(urlGroup);
      if (parsed.length > maxCount) {
        maxCount = parsed.length;
        eps = parsed;
        bestSourceName = sourceNames[idx] || ('线路' + (idx + 1));
      }
    });
    if (playUrls.length > 1 && bestSourceName) {
      toast(`已选择「${bestSourceName}」线路（共 ${eps.length} 集）`, 'info', 2000);
    }
  } else {
    eps = parseVodPlayUrl(d.vod_play_url);
  }
  els.movieEpisodes.innerHTML = '';
  const title = d.vod_name || '';
  const startIdx = parseVodProgress(eps, title);
  if (!eps.length) {
    els.movieEpisodes.innerHTML = '<div class="empty-state"><p>该资源暂无可用播放地址</p></div>';
  } else {
    eps.forEach((ep, idx) => {
      const b = document.createElement('button');
      b.className = 'movie-ep' + (idx === startIdx ? ' active' : '');
      b.textContent = ep.name;
      b.addEventListener('click', () => {
        els.movieEpisodes.querySelectorAll('.movie-ep').forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        playState.epIndex = idx;
        playState.epName = ep.name;
        playState.eps = eps;
        playState.restoreTime = 0;
        saveMovieProgress(true);
        playMovieEpisode(ep.url);
      });
      els.movieEpisodes.appendChild(b);
    });
  }
  // 建立当前剧集上下文（自动连播 / 换源保留片单）
  playState.title = title;
  playState.base = usedSrc;
  playState.vodId = id;
  playState.eps = eps;
  playState.epIndex = startIdx;
  playState.epName = eps[startIdx] ? eps[startIdx].name : '';
  if (eps.length) playMovieEpisode(eps[startIdx].url);
  else if (els.moviePlayer) els.moviePlayer.src = 'about:blank';
  els.movieSearchView.classList.add('hidden');
  els.movieDetail.classList.remove('hidden');
}

// ===== 影视下载：单集 / 批量 =====
let _movieDownloading = false;
async function downloadMovieEpisode(ep, title) {
  if (!ep || !ep.url) { toast('该集无可用播放地址', 'error'); return; }
  const saveDir = state.saveDir || await window.api.getDefaultSaveDir();
  if (!saveDir) { toast('请先在顶部设置下载目录', 'error'); return; }
  const safeName = (title || '影视').replace(/[\\/:*?"<>|]/g, '_');
  const epName = (ep.name || '').replace(/[\\/:*?"<>|]/g, '_');
  const filename = `${safeName} - ${epName || '未知集'}.mp4`;
  const taskId = 'mov_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
  // 创建任务卡片
  const task = { id: taskId, name: filename, mode: 'movie', progress: 0, status: 'running' };
  state.tasks.set(taskId, task);
  els.taskList.prepend(createTaskElement(task));
  logTask(taskId, `正在下载影视：${title || '未知'} - ${epName}`);
  logTask(taskId, '保存到：' + window.api.pathJoin(saveDir, filename));
  const parserList = getParserList();
  const referer = parserList.length ? parserList[0] : '';
  try {
    const r = await window.api.movieDownloadEpisode({ url: ep.url, filename, saveDir, referer, taskId });
    if (r.ok) {
      updateTask(taskId, { progress: 100, status: 'done' });
      logTask(taskId, `完成：${filename}`);
      const st = await window.api.fsStat(r.path);
      if (st.ok && st.exists && st.size > 1024) {
        logTask(taskId, `${(st.size / 1024 / 1024).toFixed(1)} MB`);
        doneTask(taskId, filename, r.path);
      } else {
        doneTask(taskId, filename, r.path);
      }
      toast(`下载完成：${filename}`, 'success', 3000);
    } else {
      updateTask(taskId, { status: 'error', error: r.error || '未知错误' });
      logTask(taskId, `下载失败：${r.error || '未知错误'}`);
      toast('下载失败：' + (r.error || '未知错误'), 'error', 4000);
    }
  } catch (e) {
    updateTask(taskId, { status: 'error', error: e.message });
    logTask(taskId, `异常：${e.message}`);
    toast('下载异常：' + e.message, 'error', 4000);
  }
}

async function downloadBatchEps(indices) {
  if (_movieDownloading) { toast('正在下载中，请等待完成', 'error'); return; }
  const eps = playState.eps || [];
  if (!indices.length) { toast('没有选择要下载的剧集', 'error'); return; }
  const title = playState.title || '影视';
  const saveDir = state.saveDir || await window.api.getDefaultSaveDir();
  if (!saveDir) { toast('请先在顶部设置下载目录', 'error'); return; }
  _movieDownloading = true;
  let ok = 0, fail = 0;
  const batchTaskId = 'movbatch_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
  const batchTask = { id: batchTaskId, name: `${title || '影视'} · 批量下载 ${indices.length} 集`, mode: 'movie-batch', progress: 0, status: 'running' };
  state.tasks.set(batchTaskId, batchTask);
  els.taskList.prepend(createTaskElement(batchTask));
  logTask(batchTaskId, `开始批量下载 ${indices.length} 集…`);
  toast(`开始下载 ${indices.length} 集…`, 'info', 3000);
  for (let k = 0; k < indices.length; k++) {
    const i = indices[k];
    if (i < 0 || i >= eps.length) continue;
    const ep = eps[i];
    const safeName = (title || '影视').replace(/[\\/:*?"<>|]/g, '_');
    const epName = (ep.name || '').replace(/[\\/:*?"<>|]/g, '_');
    const filename = `${safeName} - ${epName || ('第' + (i + 1) + '集')}.mp4`;
    const taskId = 'mov_' + Date.now() + '_' + k + '_' + Math.random().toString(36).slice(2, 6);
    const parserList = getParserList();
    const referer = parserList.length ? parserList[0] : '';
    try {
      logTask(batchTaskId, `正在下载：${epName || ep.name}…`);
      const r = await window.api.movieDownloadEpisode({ url: ep.url, filename, saveDir, referer, taskId });
      if (r.ok) { ok++; logTask(batchTaskId, `✓ ${epName || ep.name}`); }
      else { fail++; logTask(batchTaskId, `✗ ${epName || ep.name}`); }
    } catch (e) { fail++; logTask(batchTaskId, `✗ ${epName || ep.name}（异常）`); }
    updateTask(batchTaskId, { progress: Math.round(((k + 1) / indices.length) * 100) });
  }
  _movieDownloading = false;
  updateTask(batchTaskId, { progress: 100, status: fail > 0 ? 'error' : 'done', error: fail > 0 ? `${fail} 集失败` : '' });
  logTask(batchTaskId, `批量下载完成：成功 ${ok} 集，失败 ${fail} 集`);
  doneTask(batchTaskId, `${title || '影视'} · ${indices.length} 集`);
  toast(`批量下载完成：成功 ${ok} 集，失败 ${fail} 集`, fail > 0 ? 'error' : 'success', 4000);
}

// 影视批量下载弹窗：支持区间选择 + 多选
function showMovieDownloadPicker() {
  const eps = playState.eps || [];
  if (!eps.length) { toast('没有可下载的剧集', 'error'); return; }
  document.querySelectorAll('.movie-dl-picker-overlay').forEach(el => el.remove());
  const overlay = document.createElement('div');
  overlay.className = 'movie-dl-picker-overlay';
  overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.remove(); });
  const title = playState.title || '影视';
  const picker = document.createElement('div');
  picker.className = 'movie-src-picker';
  // 区间选择 UI
  picker.innerHTML = `
    <div style="display:flex;align-items:center;justify-content:space-between;">
      <div class="movie-src-picker-title">批量下载 · ${escapeHtml(title)}</div>
      <button class="movie-src-picker-close">✕</button>
    </div>
    <div style="padding:8px 0 4px;font-size:12px;color:var(--text-dim);">选择要下载的集数（共 ${eps.length} 集）</div>
    <div style="display:flex;gap:8px;align-items:center;margin:6px 0 10px;">
      <label style="font-size:12px;color:var(--text-dim);">从</label>
      <input id="dlRangeFrom" type="number" min="1" max="${eps.length}" value="1" style="width:60px;padding:4px 8px;border-radius:6px;border:1px solid var(--border);background:var(--bg-card);color:var(--text);font-size:13px;text-align:center;" />
      <label style="font-size:12px;color:var(--text-dim);">到</label>
      <input id="dlRangeTo" type="number" min="1" max="${eps.length}" value="${eps.length}" style="width:60px;padding:4px 8px;border-radius:6px;border:1px solid var(--border);background:var(--bg-card);color:var(--text);font-size:13px;text-align:center;" />
      <span style="font-size:12px;color:var(--text-dim);">集</span>
    </div>
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px;" id="dlQuickBtns">
      <button class="btn-ghost btn-sm dl-quick" data-s="1" data-e="${Math.min(5, eps.length)}">前5集</button>
      <button class="btn-ghost btn-sm dl-quick" data-s="1" data-e="${Math.min(10, eps.length)}">前10集</button>
      <button class="btn-ghost btn-sm dl-quick" data-s="1" data-e="${eps.length}" style="${eps.length > 50 ? 'display:none' : ''}">全部</button>
    </div>
    <div style="max-height:200px;overflow-y:auto;margin-bottom:10px;border:1px solid var(--border);border-radius:8px;padding:6px;" id="dlEpList"></div>
    <div style="display:flex;gap:8px;justify-content:flex-end;">
      <button class="btn-ghost btn-sm" id="dlSelectAll">全选</button>
      <button class="btn-primary btn-sm" id="dlConfirmBtn"><span class="btn-label">下载选中</span><span class="btn-glow"></span></button>
    </div>
  `;
  overlay.appendChild(picker);
  document.body.appendChild(overlay);

  const epListEl = picker.querySelector('#dlEpList');
  const fromInput = picker.querySelector('#dlRangeFrom');
  const toInput = picker.querySelector('#dlRangeTo');
  const selected = new Set();

  // 渲染集数列表（checkbox）
  function renderEpList() {
    epListEl.innerHTML = '';
    eps.forEach((ep, i) => {
      const row = document.createElement('label');
      row.className = 'movie-dl-ep-row';
      row.style.cssText = 'display:flex;align-items:center;gap:8px;padding:4px 6px;border-radius:6px;cursor:pointer;font-size:13px;' + (selected.has(i) ? 'background:rgba(59,130,246,0.15);' : '');
      row.innerHTML = `<input type="checkbox" ${selected.has(i) ? 'checked' : ''} style="accent-color:#3b82f6;" /><span>${escapeHtml(ep.name || ('第' + (i + 1) + '集'))}</span>`;
      row.addEventListener('click', (e) => {
        if (e.target.tagName === 'INPUT') return;
        const cb = row.querySelector('input');
        cb.checked = !cb.checked;
        if (cb.checked) selected.add(i); else selected.delete(i);
        row.style.background = cb.checked ? 'rgba(59,130,246,0.15)' : '';
      });
      row.querySelector('input').addEventListener('change', (e) => {
        if (e.target.checked) selected.add(i); else selected.delete(i);
        row.style.background = e.target.checked ? 'rgba(59,130,246,0.15)' : '';
      });
      epListEl.appendChild(row);
    });
  }
  renderEpList();

  // 区间输入联动：自动勾选区间内的集数
  function applyRange() {
    const from = Math.max(1, parseInt(fromInput.value) || 1);
    const to = Math.min(eps.length, parseInt(toInput.value) || eps.length);
    fromInput.value = from;
    toInput.value = to;
    selected.clear();
    for (let i = from - 1; i < to && i < eps.length; i++) selected.add(i);
    renderEpList();
  }
  fromInput.addEventListener('change', applyRange);
  toInput.addEventListener('change', applyRange);

  // 快捷按钮
  picker.querySelectorAll('.dl-quick').forEach(btn => {
    btn.addEventListener('click', () => {
      const s = parseInt(btn.dataset.s) - 1;
      const e = parseInt(btn.dataset.e);
      fromInput.value = s + 1;
      toInput.value = e;
      applyRange();
    });
  });

  // 全选
  picker.querySelector('#dlSelectAll').addEventListener('click', () => {
    const allSelected = selected.size === eps.length;
    if (allSelected) { selected.clear(); } else { for (let i = 0; i < eps.length; i++) selected.add(i); }
    renderEpList();
  });

  // 确认下载
  picker.querySelector('#dlConfirmBtn').addEventListener('click', () => {
    const indices = [...selected].sort((a, b) => a - b);
    if (!indices.length) { toast('请至少选择一集', 'error'); return; }
    overlay.remove();
    downloadBatchEps(indices);
  });

  // 关闭按钮
  picker.querySelector('.movie-src-picker-close').addEventListener('click', () => overlay.remove());
  // 默认选中全部
  applyRange();
}

// 绑定下载按钮
if (els.movieDownloadEp) {
  els.movieDownloadEp.addEventListener('click', () => {
    const eps = playState.eps || [];
    const idx = playState.epIndex;
    if (idx >= 0 && idx < eps.length) {
      downloadMovieEpisode(eps[idx], playState.title);
    } else {
      toast('请先播放一集再下载', 'error');
    }
  });
}
if (els.movieDownloadAll) {
  els.movieDownloadAll.addEventListener('click', () => showMovieDownloadPicker());
}

// 从本地进度恢复起始集（同名剧集 30 天内有效），并准备 seek 回时间点
function parseVodProgress(eps, title) {
  if (!eps.length || !title) return 0;
  const prog = loadMovieProgress(title);
  if (!prog) return 0;
  let idx = -1;
  if (prog.epName) {
    const eq = eps.findIndex(e => e.name === prog.epName);
    if (eq >= 0) idx = eq;
  }
  if (idx < 0 && prog.epIndex != null) idx = Math.max(0, Math.min(prog.epIndex, eps.length - 1));
  if (idx > 0 && prog.time > 3) {
    playState.restoreTime = prog.time;
  }
  if (idx > 0 || prog.time > 3) {
    setTimeout(() => toast(`已根据上次进度续播：${eps[idx].name || ''}${prog.time > 3 ? '（约' + Math.round(prog.time / 60) + '分钟处）' : ''}`, 'success', 2500), 800);
  }
  return idx;
}

let playState = {
  url: '', pIdx: 0,
  eps: [], epIndex: -1, epName: '', title: '', base: '', vodId: '',
  parserList: [],
  failCount: 0, deadSince: 0, aliveAt: 0,
  restoreTime: 0, endedHandled: false, _savedTime: 0, _lastSave: 0, _iframeLoaded: false,
};
let lastAggregation = [];   // 最近一次聚合搜索结果，用于详情失败时换源兜底

function markParserDead(parserUrl, minutes) {
  const dead = JSON.parse(localStorage.getItem('movieDeadParsers') || '{}');
  dead[parserUrl] = Date.now() + (minutes || 30) * 60000;
  localStorage.setItem('movieDeadParsers', JSON.stringify(dead));
}
function isParserDead(parserUrl) {
  const dead = JSON.parse(localStorage.getItem('movieDeadParsers') || '{}');
  if (dead[parserUrl] && Date.now() < dead[parserUrl]) return true;
  if (dead[parserUrl] && Date.now() >= dead[parserUrl]) { delete dead[parserUrl]; localStorage.setItem('movieDeadParsers', JSON.stringify(dead)); }
  return false;
}

function getParserList() {
  const { parser } = movieConfig();
  const good = localStorage.getItem('movieGoodParser') || '';
  const list = [];
  if (good && good !== parser && !isParserDead(good)) list.push(good);
  if (parser && !isParserDead(parser)) list.push(parser);
  MOVIE_PARSER_PRESETS.forEach(p => { if (p && p !== parser && p !== good && !isParserDead(p)) list.push(p); });
  return list.length ? list : [parser].filter(Boolean);
}

async function playMovieEpisode(url, pIdxOverride) {
  // 直链优先：CMS 源提供的 m3u8/mp4/flv 等可直接播放，无需经过解析器
  if (isDirectMediaUrl(url)) { playDirectMedia(url); return; }

  // 分享/短链（如 v.cdn*.com/share/xxx）：通过本地服务抓页解析出真实 m3u8 再直链播放
  if (/^https?:\/\//i.test(url)) {
    try {
      const r = await window.api.movieServerApi('/api/resolve', { url });
      if (r && r.ok && r.data && r.data.code === 0 && r.data.url && /\.(m3u8|mp4)(\?|$)/i.test(r.data.url)) {
        playDirectMedia(r.data.url);
        return;
      }
    } catch (_) {}
  }

  const parserList = getParserList();
  if (!parserList.length) { toast('请先在「数据源」中设置解析接口', 'error'); return; }

  const idx = (typeof pIdxOverride === 'number' && pIdxOverride >= 0)
    ? pIdxOverride % parserList.length
    : 0;

  playState.url = url;
  playState.pIdx = idx;
  playState.parserList = parserList;
  playState.failCount = 0;
  playState.deadSince = 0;
  playState.endedHandled = false;
  playState.aliveAt = Date.now();
  playState._iframeLoaded = false;

  const cur = parserList[idx];
  if (!/^https?:\/\//i.test(cur)) { toast('解析接口需以 http(s):// 开头', 'error'); return; }
  const sep = cur.includes('?') ? (cur.endsWith('=') ? '' : '&') : '?';
  els.moviePlayer.src = cur + sep + encodeURIComponent(url);
  // 通知主进程当前解析线路的 Origin，用于为媒体请求重写 Referer 防盗链
  try { window.api.movieSetReferer(cur); } catch (e) {}
  if (els.movieParserCurrent) els.movieParserCurrent.textContent = cur.replace(/^https?:\/\//, '');
  if (els.movieParserSwitchBtn) els.movieParserSwitchBtn.disabled = false;
  // 只要换了解析就清掉自动切换标记
  playState.fallbackPending = false;
  armParserFailTimer();
  startMovieProbe();

  // 预取下一集解析 URL，避免切换集时卡顿
  prefetchNextEpisode();
}

// 判断是否为可直接播放的直链（CMS 源常直接给 m3u8/mp4/flv）
function isDirectMediaUrl(u) {
  if (!u) return false;
  let s = String(u).split('#')[0].split('?')[0].toLowerCase();
  if (/\.(m3u8|mp4|flv|webm|ogg|mov)(\/|$)/.test(s) && /^https?:\/\//i.test(u)) return true;
  // 部分 m3u8 链接无 .m3u8 扩展名但含 m3u8 特征路径
  if (/^https?:\/\//i.test(u) && /(\.m3u8(\?|$)|\.mp4(\?|$))/i.test(u)) return true;
  return false;
}

// 直链播放：通过本地 movie-api 服务器的 /player.html 播放（含 hls.js CDN）
async function playDirectMedia(url) {
  playState.url = url;
  playState.pIdx = -1;               // -1 表示直链模式（不走解析器）
  playState.parserList = [];
  playState.failCount = 0;
  playState.deadSince = 0;
  playState.endedHandled = false;
  playState.aliveAt = Date.now();
  playState._iframeLoaded = false;
  playState.fallbackPending = false;

  if (els.movieParserCurrent) els.movieParserCurrent.textContent = '直链播放';
  if (els.movieParserSwitchBtn) els.movieParserSwitchBtn.disabled = true;
  try { window.api.movieSetReferer(null); } catch (e) {}

  // 通过本地服务器播放：webSecurity:false 已允许 file:// 嵌入 http://127.0.0.1 iframe
  try {
    const sv = await window.api.movieServerStatus();
    const port = (sv && sv.ok && sv.port) ? sv.port : 3928;
    els.moviePlayer.src = 'http://127.0.0.1:' + port + '/player.html?url=' + encodeURIComponent(url);
  } catch (_) {
    // 回退：直接 data: URL（hls.js CDN 可能无法加载）
    const playerHTML = buildDirectPlayerHTML(url);
    els.moviePlayer.src = 'data:text/html;charset=utf-8,' + encodeURIComponent(playerHTML);
  }
  stopMovieProbe();
  startMovieProbe();
  prefetchNextEpisode();
}

// 构建直链播放器 data:URL HTML（含 hls.js CDN）
function buildDirectPlayerHTML(src) {
  return `<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="UTF-8" />
<title>影视播放器</title>
<style>
  html, body { margin:0; height:100%; background:#000; overflow:hidden; }
  #player { width:100%; height:100%; display:block; background:#000; }
  #err { display:none; position:absolute; inset:0; color:#f66; font-family:sans-serif;
         align-items:center; justify-content:center; text-align:center; font-size:14px;
         line-height:1.8; padding:20px; box-sizing:border-box; }
</style></head>
<body><video id="player" controls autoplay playsinline></video>
<div id="err"></div>
<script src="https://cdn.jsdelivr.net/npm/hls.js@latest/dist/hls.min.js"><\/script>
<script>
  const v = document.getElementById('player');
  const errEl = document.getElementById('err');
  function fail(m){ errEl.style.display='flex'; errEl.textContent=m; v.style.display='none'; }
  const src = ${JSON.stringify(src)};
  if (!src) { fail('未提供播放地址'); }
  else if (window.Hls && Hls.isSupported() && /\\.m3u8(\\?|$)/i.test(src)) {
    const hls = new Hls({ enableWorker: true, lowLatencyMode: true });
    hls.loadSource(src);
    hls.attachMedia(v);
    hls.on(Hls.Events.MANIFEST_PARSED, () => v.play().catch(_=>{}));
    hls.on(Hls.Events.ERROR, (e, d) => { if (d.fatal) fail('HLS 致命错误：' + d.type + ' ' + d.details); });
  } else {
    v.src = src;
    v.onerror = () => fail('播放出错：' + (v.error ? (v.error.message||v.error.code) : '未知') + '<br>源：' + src.slice(0,120));
  }
<\/script></body></html>`;
}

// 预取下一集：提前加载下一集的 iframe，让用户切集时几乎零等待
let _prefetchFrame = null;
function prefetchNextEpisode() {
  const eps = playState.eps || [];
  const nextIdx = playState.epIndex + 1;
  if (nextIdx >= eps.length) return; // 已是最后一集
  const nextUrl = eps[nextIdx].url;
  if (!nextUrl) return;
  const parserList = getParserList();
  if (!parserList.length) return;
  const parserUrl = parserList[0];
  const sep = parserUrl.includes('?') ? (parserUrl.endsWith('=') ? '' : '&') : '?';
  // 创建隐藏 iframe 预加载下一集
  try {
    if (_prefetchFrame) { _prefetchFrame.remove(); _prefetchFrame = null; }
    _prefetchFrame = document.createElement('iframe');
    _prefetchFrame.style.cssText = 'position:fixed;left:-9999px;top:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;border:none;';
    _prefetchFrame.src = parserUrl + sep + encodeURIComponent(nextUrl);
    document.body.appendChild(_prefetchFrame);
    // 30 秒后移除预加载 iframe（避免内存占用）
    setTimeout(() => { if (_prefetchFrame) { _prefetchFrame.remove(); _prefetchFrame = null; } }, 30000);
  } catch (_) {}
}

// ===== 自动连播 / 自动换源 / 进度记忆 =====
const MOVIE_PROGRESS_PREFIX = 'movieProgress:';
let movieProbeTimer = null;

function loadMovieProgress(title) {
  if (!title) return null;
  try { return JSON.parse(localStorage.getItem(MOVIE_PROGRESS_PREFIX + title) || 'null'); }
  catch (e) { return null; }
}

function saveMovieProgress(force) {
  if (!playState.title || playState.epIndex < 0) return;
  const now = Date.now();
  if (!force && playState._lastSave && now - playState._lastSave < 8000) return;
  playState._lastSave = now;
  try {
    localStorage.setItem(MOVIE_PROGRESS_PREFIX + playState.title, JSON.stringify({
      epIndex: playState.epIndex,
      epName: playState.eps[playState.epIndex] ? playState.eps[playState.epIndex].name : playState.epName,
      title: playState.title,
      base: playState.base,
      vodId: playState.vodId,
      time: playState._savedTime || 0,
      ts: now,
    }));
  } catch (e) {}
}

function clearMovieProgress(title) {
  try { localStorage.removeItem(MOVIE_PROGRESS_PREFIX + title); } catch (e) {}
}

// 高亮并播放指定集
function playEpisodeByIndex(idx) {
  if (!playState.eps.length) return;
  const i = Math.max(0, Math.min(idx, playState.eps.length - 1));
  playState.epIndex = i;
  playState.epName = playState.eps[i].name;
  playState.restoreTime = 0;
  playState._savedTime = 0;
  saveMovieProgress(true);
  const list = els.movieEpisodes.querySelectorAll('.movie-ep');
  list.forEach((b, k) => b.classList.toggle('active', k === i));
  playMovieEpisode(playState.eps[i].url, 0);
}

// 自动连播：当前集播完跳下一集
function handleEpisodeEnded() {
  if (playState.endedHandled) return;
  playState.endedHandled = true;
  saveMovieProgress(true);
  const auto = els.movieAutoNext ? els.movieAutoNext.checked : true;
  const eps = playState.eps || [];
  if (auto && playState.epIndex >= 0 && playState.epIndex < eps.length - 1) {
    toast('播放完毕，下一集', 'success', 2000);
    playEpisodeByIndex(playState.epIndex + 1);
  } else {
    toast('本集已播放完毕', 'info', 3000);
  }
}

// 当前线路异常：先换解析线路，线路用尽后尝试换搜索源（保持同一集坐标）
async function tryAutoSwitch(linesChanged) {
  const now = Date.now();
  if (playState.deadSince && now - playState.deadSince < 6000) return;  // 防抖：6s 内不重复切换
  playState.deadSince = now;
  playState.failCount++;

  const parserList = playState.parserList.length ? playState.parserList : getParserList();

  if (playState.pIdx < parserList.length - 1) {
    const deadUrl = parserList[playState.pIdx];
    if (deadUrl) markParserDead(deadUrl, 30);  // 标记当前解析器为死线30分钟
    toast('线路加载失败，换一条', 'info', 2500);
    playState.restoreTime = playState._savedTime || 0;
    switchToNextParser();
    return;
  }

  // 所有解析线路都试过 → 换搜索源（同剧集、本地图库仍保留）
  const title = playState.title;
  const cands = lastAggregation.filter(it => it.vod_name === title && it._src && it._src !== playState.base);
  for (const a of cands) {
    try {
      const rr = await window.api.movieDetail(a._src, a.vod_id);
      if (rr.ok && rr.data) {
        // 多线路：选集数最多的一条
        const playUrlGroups = (rr.data.vod_play_url || '').split('$$$');
        let candEps = [];
        playUrlGroups.forEach(g => {
          const parsed = parseVodPlayUrl(g);
          if (parsed.length > candEps.length) candEps = parsed;
        });
        if (!candEps.length) continue;
        // 对应当前集：优先同名，其次同索引
        const name = playState.epName || (playState.eps[playState.epIndex] || {}).name;
        let target = -1;
        if (name) {
          const eq = candEps.findIndex(e => e.name === name);
          if (eq >= 0) target = eq;
        }
        if (target < 0) target = Math.max(0, Math.min(playState.epIndex, candEps.length - 1));
        toast(`已自动切换到片源 ${a._src.replace(/^https?:\/\//, '').split('/')[0]}`, 'success', 2500);
        // 保底保留上一集进度；进度恢复在播放器就绪后 seek
        playState.eps = candEps;
        playState.epIndex = target;
        playState.epName = candEps[target].name;
        playState.base = a._src;
        playState.vodId = a.vod_id;
        playState.restoreTime = playState._savedTime || 0;
        const list = els.movieEpisodes.querySelectorAll('.movie-ep');
        list.forEach((b, k) => b.classList.toggle('active', k === target));
        saveMovieProgress(true);
        playMovieEpisode(candEps[target].url, 0);
        return;
      }
    } catch (e) { /* 换源失败继续试下一个 */ }
  }
  toast('所有线路都挂了，换个搜索源试试', 'error', 4000);
}

// 探测播放器内部 <video> 状态：播完→连播；异常→自动换线路/换源；期间记忆进度
function startMovieProbe() {
  if (movieProbeTimer) return;
  movieProbeTimer = setInterval(async () => {
    if (!playState.url || (els.movieDetail && els.movieDetail.classList.contains('hidden'))) return;
    let r = null;
    try { r = await window.api.movieProbe(); } catch (e) { r = null; }

    // 始终检查解析器是否返回了错误文本（如"不支持的视频平台"），加快故障发现
    try {
      const txt = await window.api.movieCheckText();
      if (txt && txt.hasError) {
        await tryAutoSwitch(true);
        return;
      }
    } catch (e) {}

    // 自动点击解析器页面的"立即播放"按钮（许多解析站需手动点一次）
    try { await window.api.movieAutoPlayBtn(); } catch (_) {}

    if (!r || !r.found) {
      // 没有找到 video：给 4s 窗口（广告/加载慢）再判定失效，加快故障检测
      if (playState.aliveAt && Date.now() - playState.aliveAt > 4000) await tryAutoSwitch(true);
      return;
    }

    playState.aliveAt = Date.now();
    // 播放器开始真实加载：记住当前解析线路，下次优先复用
    if (r.readyState >= 2 || r.duration > 0) {
      const goodParser = playState.parserList && playState.parserList[playState.pIdx];
      if (goodParser) { try { localStorage.setItem('movieGoodParser', goodParser); } catch (_) {} }
    }
    if (r.ended) { handleEpisodeEnded(); return; }
    if (r.error || (r.readyState === 0 && r.networkState === 3)) {
      await tryAutoSwitch(false);
      return;
    }
    if (r.duration > 0 && r.currentTime > 0) {
      playState._savedTime = r.currentTime;
      // 进度恢复：等播放器有真实时长后 seek 到记忆位置
      if (playState.restoreTime > 3 && r.duration > playState.restoreTime + 2) {
        const t = playState.restoreTime;
        playState.restoreTime = 0;
        try { await window.api.movieSeek(t); } catch (e) {}
      }
      saveMovieProgress(false);
    }
  }, 2000);
}

function stopMovieProbe() {
  if (movieProbeTimer) { clearInterval(movieProbeTimer); movieProbeTimer = null; }
}

function switchToNextParser() {
  const parserList = playState.parserList.length ? playState.parserList : getParserList();
  const next = (playState.pIdx + 1) % parserList.length;
  playState.restoreTime = playState._savedTime || 0;   // 换线路后自动回到当前进度
  playMovieEpisode(playState.url, next);
  toast('已切换到解析线路 ' + (parserList[next] ? parserList[next].replace(/^https?:\/\//, '').split('/')[0] : ''),
    'info', 2000);
}

function showMovieSearchView() {
  saveMovieProgress(true);
  stopMovieProbe();
  playState.url = '';
  els.moviePlayer.src = 'about:blank';
  els.movieDetail.classList.add('hidden');
  els.movieSearchView.classList.remove('hidden');
}

