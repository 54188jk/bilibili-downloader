    folder: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.5 6.5A1.5 1.5 0 0 1 5 5h4l2 2.5h8a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 18V6.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>',
    layers: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 21 8l-9 5-9-5 9-5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M4.5 13.5 12 17.5l7.5-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    merge: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4v6a4 4 0 0 0 4 4h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 10.5 18 14l-4 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    key: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="8" cy="12" r="3.5" stroke="currentColor" stroke-width="1.7"/><path d="m10.5 14.5 7 7m-2-2 2-2m2 2 2-2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    zap: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12L13 2z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>',
    shield: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 20 6v6c0 4.5-3.2 7.7-8 9-4.8-1.3-8-4.5-8-9V6l8-3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  };
  const FEATURES = [
    { icon: IC.film, title: 'B站视频下载', desc: '多画质 · DASH 合并 · 弹幕', color: '#d97a9f' },
    { icon: IC.music, title: '抖音无水印', desc: '视频/音频/无声流', color: '#4fb0a6' },
    { icon: IC.play, title: '快手无水印', desc: '视频无水印下载', color: '#e0743c' },
    { icon: IC.music, title: '本地音乐', desc: '网易云搜索 · 歌单 · 歌词', color: '#5b7fb0' },
    { icon: IC.cloud, title: '汽水音乐解析', desc: '抖音音乐直链解析', color: '#2f9bb8' },
    { icon: IC.folder, title: 'UC 网盘', desc: '分享链接文件检测', color: '#e0743c' },
    { icon: IC.layers, title: '批量下载', desc: '清单勾选 · 队列下载', color: '#1f9d74' },
    { icon: IC.merge, title: 'DASH 合并', desc: '音视频流自动合并', color: '#c2567c' },
    { icon: IC.key, title: '多平台登录', desc: 'B站 · 抖音 · 网易云', color: '#4a6bd0' },
    { icon: IC.zap, title: '批量解析', desc: '多链接同时处理', color: '#c9a23a' },
    { icon: IC.shield, title: '安全存储', desc: 'Cookie 加密 · 本地持久', color: '#2f9a6f' },
  ];

  // === 创建面板 ===
  const panel = document.createElement('div');
  panel.className = 'feature-intro hidden';
  panel.innerHTML = `
    <div class="fi-overlay"></div>
    <canvas class="fi-particles" id="fiParticles"></canvas>
    <div class="fi-stage">
      <button class="fi-close" title="关闭">✕</button>
      <div class="fi-slides" id="fiSlides">
        ${FEATURES.map((f, i) => `
          <div class="fi-slide" data-idx="${i}" style="--accent:${f.color}">
            <div class="fi-slide-icon">${f.icon}</div>
            <div class="fi-slide-title">${f.title}</div>
            <div class="fi-slide-desc">${f.desc}</div>
          </div>
        `).join('')}
      </div>
      <div class="fi-controls">
        <button class="fi-nav fi-prev" title="上一个">‹</button>
        <div class="fi-dots" id="fiDots">
          ${FEATURES.map((_, i) => `<span class="fi-dot${i === 0 ? ' active' : ''}" data-idx="${i}"></span>`).join('')}
        </div>
        <button class="fi-nav fi-next" title="下一个">›</button>
      </div>
      <div class="fi-progress"><div class="fi-progress-bar" id="fiProgressBar"></div></div>
    </div>
  `;
  document.body.appendChild(panel);

  // === 粒子动画 ===
  let particleAnim = null;
  function initParticles() {
    const canvas = document.getElementById('fiParticles');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let W, H;
    const particles = [];
    const COUNT = 35;
    function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
    resize();
    window.addEventListener('resize', resize);
    for (let i = 0; i < COUNT; i++) {
      particles.push({
        x: Math.random() * W, y: Math.random() * H,
        r: Math.random() * 2 + 1,
        vx: (Math.random() - 0.5) * 0.5, vy: (Math.random() - 0.5) * 0.5,
        alpha: Math.random() * 0.5 + 0.2,
        hue: Math.random() * 60 + 220,
        pulse: Math.random() * Math.PI * 2,
      });
    }
    function draw() {
      ctx.clearRect(0, 0, W, H);
      particles.forEach(p => {
        p.x += p.vx; p.y += p.vy; p.pulse += 0.02;
        if (p.x < 0) p.x = W; if (p.x > W) p.x = 0;
        if (p.y < 0) p.y = H; if (p.y > H) p.y = 0;
        const a = p.alpha * (0.6 + 0.4 * Math.sin(p.pulse));
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `hsla(${p.hue},70%,65%,${a})`; ctx.fill();
        ctx.beginPath(); ctx.arc(p.x, p.y, p.r * 4, 0, Math.PI * 2);
        ctx.fillStyle = `hsla(${p.hue},70%,65%,${a * 0.12})`; ctx.fill();
      });
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x, dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 110) {
            ctx.beginPath(); ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `hsla(240,60%,65%,${0.1 * (1 - dist / 110)})`;
            ctx.lineWidth = 0.5; ctx.stroke();
          }
        }
      }
      particleAnim = requestAnimationFrame(draw);
    }
    draw();
  }
  function stopParticles() { if (particleAnim) { cancelAnimationFrame(particleAnim); particleAnim = null; } }

  // === 幻灯片控制 ===
  let curIdx = 0;
  const total = FEATURES.length;
  let autoTimer = null;

  function goTo(idx) {
    if (idx < 0) idx = total - 1;
    if (idx >= total) idx = 0;
    curIdx = idx;
    const slides = panel.querySelectorAll('.fi-slide');
    slides.forEach((s, i) => {
      s.classList.toggle('active', i === curIdx);
      s.classList.toggle('prev', i < curIdx);
    });
    // 更新 dots
    panel.querySelectorAll('.fi-dot').forEach((d, i) => d.classList.toggle('active', i === curIdx));
    // 更新进度条
    const bar = document.getElementById('fiProgressBar');
    if (bar) bar.style.width = ((curIdx + 1) / total * 100) + '%';
    // 重置自动播放
    resetAuto();
  }

  function resetAuto() {
    if (autoTimer) clearInterval(autoTimer);
    autoTimer = setInterval(() => goTo(curIdx + 1), 3500);
  }

  function openIntro() {
    panel.classList.remove('hidden');
    panel.classList.add('fi-entering');
    initParticles();
    goTo(0);
    setTimeout(() => panel.classList.remove('fi-entering'), 400);
  }

  function closeIntro() {
    if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    stopParticles();
    panel.classList.add('fi-leaving');
    setTimeout(() => {
      panel.classList.add('hidden');
      panel.classList.remove('fi-leaving');
    }, 350);
  }

  // === 事件绑定 ===
  panel.querySelector('.fi-close')?.addEventListener('click', closeIntro);
  panel.querySelector('.fi-overlay')?.addEventListener('click', closeIntro);
  panel.querySelector('.fi-prev')?.addEventListener('click', () => goTo(curIdx - 1));
  panel.querySelector('.fi-next')?.addEventListener('click', () => goTo(curIdx + 1));
  panel.querySelectorAll('.fi-dot').forEach(d => {
    d.addEventListener('click', () => goTo(Number(d.dataset.idx)));
  });

  // 键盘导航
  document.addEventListener('keydown', (e) => {
    if (panel.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeIntro();
    else if (e.key === 'ArrowLeft') goTo(curIdx - 1);
    else if (e.key === 'ArrowRight') goTo(curIdx + 1);
  });

  // 触摸滑动
  let touchStartX = 0;
  panel.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  panel.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) goTo(curIdx + (dx < 0 ? 1 : -1));
  }, { passive: true });

  // === 在平台切换栏中插入「功能介绍」按钮 ===
  const switchEl = document.querySelector('.platform-switch');
  if (switchEl) {
    const featBtn = document.createElement('button');
    featBtn.className = 'platform-btn feature-trigger';
    featBtn.title = '功能介绍';
    featBtn.innerHTML = `<span class="feature-trigger-ic"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.7"/><rect x="13" y="3" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.7"/><rect x="3" y="13" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.7"/><rect x="13" y="13" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.7"/></svg></span><span>功能介绍</span>`;
    featBtn.addEventListener('click', openIntro);
    const ucBtn = document.getElementById('platformUc');
    if (ucBtn && ucBtn.nextSibling) {
      switchEl.insertBefore(featBtn, ucBtn.nextSibling);
    } else {
      switchEl.appendChild(featBtn);
    }
  }

  // === 影视 / B站 / 抖音 Tab 切换 ===
  const movieTabs = document.querySelectorAll('.movie-tab');
  const movieTabContents = document.querySelectorAll('.movie-tab-content');
  movieTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.movieTab;
      movieTabs.forEach(t => t.classList.toggle('active', t === tab));
      movieTabContents.forEach(c => c.classList.toggle('hidden', c.dataset.tabContent !== target));
    });
  });

  // ===== 教程 =====
  const tutorialBtn = document.getElementById('tutorialBtn');
  if (tutorialBtn) {
    tutorialBtn.addEventListener('click', async () => {
      if (window.api && window.api.openTutorial) {
        try { await window.api.openTutorial(); return; } catch (_) {}
      }
      if (window.api && window.api.getTutorialPath && window.api.openPath) {
        try {
          const tutorialPath = await window.api.getTutorialPath();
          if (tutorialPath) window.api.openPath(tutorialPath);
        } catch (_) {}
      }
    });
  }

  // ===== 自定义背景视频（body.bg-video）=====
  const bgVideoBtn = document.getElementById('bgVideoBtn');
  const bgVideo = document.getElementById('bgVideo');
  const bgVideoTag = document.getElementById('bgVideoTag');
  const bgVideoName = document.getElementById('bgVideoName');
  const bgVideoCloseBtn = document.getElementById('bgVideoCloseBtn');
  const BG_VIDEO_KEY = 'biligrab_bgvideo';   // blob URL 或空字符串

  function showBgVideoTag(label) {
    if (!bgVideoTag) return;
    if (label) bgVideoName.textContent = label;
    bgVideoTag.classList.remove('hidden');
  }
  function hideBgVideoTag() {
    if (!bgVideoTag) return;
    bgVideoTag.classList.add('hidden');
  }

  function stopBgVideo() {
    if (!bgVideo) return;
    bgVideo.pause();
    bgVideo.removeAttribute('src');
    bgVideo.load();
    document.body.classList.remove('bg-video');
    hideBgVideoTag();
    try { localStorage.removeItem(BG_VIDEO_KEY); } catch (_) {}
  }

  function startBgVideo(url, label) {
    if (!bgVideo) return;
    try {
      bgVideo.removeAttribute('src');
      bgVideo.load();
    } catch (_) {}
    bgVideo.src = url;
    bgVideo.style.display = 'block';
    document.body.classList.add('bg-video');
    showBgVideoTag(label || '自定义背景视频');
    try { localStorage.setItem(BG_VIDEO_KEY, url); } catch (_) {}
    // 等 src 设置完成后再生——失败静默处理
    const onCanPlay = () => {
      bgVideo.play().catch(() => {});
      bgVideo.removeEventListener('canplay', onCanPlay);
    };
    bgVideo.addEventListener('canplay', onCanPlay);
  }

  function chooseBgVideo() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'video/*';
    input.style.display = 'none';
    document.body.appendChild(input);
    input.addEventListener('change', () => {
      const file = input.files && input.files[0];
      document.body.removeChild(input);
      if (!file) return;
      const url = URL.createObjectURL(file);
      const label = file.name || '自定义背景视频';
      startBgVideo(url, label);
    });
    input.click();
  }

  // 从 localStorage 恢复背景视频（如果存在）
  (function initBgVideo() {
    let savedUrl = null;
    try { savedUrl = localStorage.getItem(BG_VIDEO_KEY); } catch (_) {}
    if (savedUrl && savedUrl.trim() && bgVideo) {
      startBgVideo(savedUrl, '已恢复的背景视频');
    }
  })();

  if (bgVideoBtn) {
    bgVideoBtn.addEventListener('click', () => {
      if (document.body.classList.contains('bg-video')) {
        stopBgVideo();
      } else {
        chooseBgVideo();
      }
    });
  }
  if (bgVideoCloseBtn) {
    bgVideoCloseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      stopBgVideo();
    });
  }

  // ===== 主题切换（深色/浅色 + 玻璃/普通）=====
  const themeToggle = document.getElementById('themeToggle');
  const glassToggle = document.getElementById('glassToggle');
  const THEME_KEY = 'biligrab_theme';      // 'dark' | 'light'
  const GLASS_KEY = 'biligrab_glass';      // 'glass' | 'plain'

  function applyTheme(theme) {
    const dark = theme === 'dark';
    document.body.classList.toggle('dark', dark);
    if (themeToggle) {
      themeToggle.classList.toggle('active', dark);
      themeToggle.title = dark ? '切换为浅色模式' : '切换为深色模式';
    }
    // 光晕扩散：触发扩散类，并在过渡结束后清理掉
    const body = document.body;
    if (body) {
      body.classList.remove('glow-transition');
      void body.offsetWidth; // reflow 以确保动画重放
      body.classList.add('glow-transition');
      body.addEventListener('transitionend', () => body.classList.remove('glow-transition'), { once: true });
    }
    try { localStorage.setItem(THEME_KEY, theme); } catch (_) {}
  }
  function applyGlass(glass) {
    document.body.classList.toggle('glass', glass === 'glass');
    if (glassToggle) {
      glassToggle.classList.toggle('active', glass === 'glass');
      glassToggle.title = glass === 'glass' ? '切换为普通模式' : '切换为液态玻璃模式';
    }
    try { localStorage.setItem(GLASS_KEY, glass); } catch (_) {}
  }

  // 初始化：优先 localStorage，否则跟随系统
  // 设计稿 v2 落地：首次升级到 v2 皮肤时强制一次浅色（纯白底），之后仍尊重用户选择
  (function initTheme() {
    let theme;
    try { theme = localStorage.getItem(THEME_KEY); } catch (_) {}
    let v2Applied = false;
    try { v2Applied = localStorage.getItem('biligrab_theme_v2') === '1'; } catch (_) {}
    if (!v2Applied) {
      theme = 'light';
      try { localStorage.setItem('biligrab_theme_v2', '1'); } catch (_) {}
    }
    if (!theme) {
      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      theme = prefersDark ? 'dark' : 'light';
    }
    let glass;
    try { glass = localStorage.getItem(GLASS_KEY); } catch (_) {}
    if (!glass) glass = 'glass';
    applyTheme(theme);
    applyGlass(glass);
  })();

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const next = document.body.classList.contains('dark') ? 'light' : 'dark';
      applyTheme(next);
      // 触发点击位置的光晕脉冲（粒子扩散）
      const rect = themeToggle.getBoundingClientRect();
      spawnGlowPulse(rect.left + rect.width / 2, rect.top + rect.height / 2, next === 'dark' ? 'dark' : 'light');
    });
  }
  if (glassToggle) {
    glassToggle.addEventListener('click', () => {
      const next = document.body.classList.contains('glass') ? 'plain' : 'glass';
      applyGlass(next);
    });
  }

  // ===== 主题切换光晕脉冲（粒子扩散）=====
  function spawnGlowPulse(x, y, mode) {
    const existing = document.querySelector('.theme-glow');
    if (!existing) return;

    const isDark = mode === 'dark';
    const colors = isDark
      ? { core: 'rgba(140,170,255,0.7)', pulse: 'radial-gradient(circle, rgba(140,170,255,0.55), rgba(80,120,255,0.18) 55%, transparent 75%)', ring: 'rgba(160,190,255,0.6)', grad: 'radial-gradient(circle, rgba(150,180,255,0.5), rgba(100,140,255,0.2) 55%, transparent 75%)', particle: ['rgba(150,180,255,0.8)','rgba(110,150,255,0.7)','rgba(80,130,255,0.6)'] }
      : { core: 'rgba(90,130,255,0.6)', pulse: 'radial-gradient(circle, rgba(60,90,200,0.38), rgba(59,130,246,0.12) 55%, transparent 75%)', ring: 'rgba(120,160,255,0.5)', grad: 'radial-gradient(circle, rgba(70,110,255,0.4), rgba(59,130,246,0.12) 55%, transparent 75%)', particle: ['rgba(90,130,255,0.7)','rgba(70,110,255,0.6)','rgba(50,90,255,0.5)'] };

    // 核心缩放反馈
    const core = document.createElement('div');
    core.className = 'theme-glow-core';
    core.style.left = x + 'px';
    core.style.top = y + 'px';
    core.style.width = (46) + 'px';
    core.style.height = (46) + 'px';
    core.style.background = colors.core;
    existing.appendChild(core);
    core.addEventListener('animationend', () => core.remove(), { once: true });

    // 扩散脉冲
    const pulse = document.createElement('div');
    pulse.className = 'theme-glow-pulse';
    pulse.style.left = x + 'px';
    pulse.style.top = y + 'px';
    pulse.style.width = (80) + 'px';
    pulse.style.height = (80) + 'px';
    pulse.style.background = colors.pulse;
    existing.appendChild(pulse);
    pulse.addEventListener('animationend', () => pulse.remove(), { once: true });

    // 扩散轨道环
    const ring = document.createElement('div');
    ring.className = 'theme-glow-ring';
    ring.style.left = x + 'px';
    ring.style.top = y + 'px';
    ring.style.width = (80) + 'px';
    ring.style.height = (80) + 'px';
    ring.style.borderColor = colors.ring;
    existing.appendChild(ring);
    ring.addEventListener('animationend', () => ring.remove(), { once: true });

    // 颜色渐变扩散
    const grad = document.createElement('div');
    grad.className = 'theme-glow-grad';
    grad.style.left = x + 'px';
    grad.style.top = y + 'px';
    grad.style.width = (90) + 'px';
    grad.style.height = (90) + 'px';
    grad.style.background = colors.grad;
    existing.appendChild(grad);
    grad.addEventListener('animationend', () => grad.remove(), { once: true });

    // 多粒子散开
    for (let i = 0; i < 9; i++) {
      const p = document.createElement('div');
      p.className = 'theme-glow-particle';
      const angle = (i / 9) * Math.PI * 2;
      const dist = 90 + Math.random() * 110;
      const tx = Math.cos(angle) * dist;
      const ty = Math.sin(angle) * dist;
      p.style.setProperty('--tx', tx + 'px');
      p.style.setProperty('--ty', ty + 'px');
      p.style.left = x + 'px';
      p.style.top = y + 'px';
      p.style.width = (4 + Math.random() * 5) + 'px';
      p.style.height = p.style.width;
      p.style.background = colors.particle[Math.floor(Math.random() * colors.particle.length)];
      p.style.animationDelay = (Math.random() * 0.12) + 's';
      p.style.animation = 'none';
      existing.appendChild(p);
      void p.offsetWidth;
      p.style.animation = '';
      p.addEventListener('animationend', () => p.remove(), { once: true });
    }
  }

  // ===== 下载历史 =====
  const historyModal = document.getElementById('historyModal');
  const historyList = document.getElementById('historyList');
  const historyBtn = document.getElementById('downloadHistoryBtn');

  function historyKindIcon(k) {
    if (k === 'music') {
      return '<svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4.25 13.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/><path d="M6.75 11V.5a5.5 5.5 0 0 1 5.5 5.5"/></g></svg>';
    }
    if (k === 'movie') {
      return '<svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M2.5 12.5V1.5h9a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-9z"/><path d="M6 6.2v2.6l2.3-1.3z" fill="currentColor"/></svg>';
    }
    return '<svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 8 7 10.5 9.5 8M7 10.5v-7"/><path d="M7 13.5a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13"/></g></svg>';
  }

  function formatHistoryTime(t) {
    const d = new Date(t || Date.now());
    return d.toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
  }

  function renderHistory(list) {
    if (!historyList) return;
    if (!list || !list.length) {
      historyList.innerHTML = '<div class="history-empty">暂无下载记录</div>';
      return;
    }
    historyList.innerHTML = '';
    for (const h of list) {
      const item = document.createElement('div');
      item.className = 'history-item';
      const sizeTxt = h.size ? (h.size / 1024 / 1024).toFixed(1) + ' MB' : '';
      item.innerHTML = `
        <div class="history-kind k-${h.kind || 'video'}">${historyKindIcon(h.kind)}</div>
        <div class="history-item-main">
          <div class="history-item-title">${escapeHtml(h.title || h.filename || '未知文件')}</div>
          <div class="history-item-sub">${escapeHtml(h.dir || '')}${sizeTxt ? ' · ' + sizeTxt : ''} · ${formatHistoryTime(h.time)}</div>
        </div>
        <div class="history-item-actions">
          <button class="history-remove-btn" data-id="${escapeHtml(h.id)}" title="删除记录">
            <svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M3.5 4.5h7M6 1.5h2M2.5 4.5l.7 7a1.2 1.2 0 0 0 1.2 1.1h5.2a1.2 1.2 0 0 0 1.2-1.1l.7-7"/></svg>
          </button>
        </div>`;
      const rm = item.querySelector('.history-remove-btn');
      if (rm) rm.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = rm.getAttribute('data-id');
        try { renderHistory(await window.api.historyRemove(id)); } catch (_) {}
      });
      item.addEventListener('click', () => {
        if (window.api.openPath && h.dir) window.api.openPath(h.dir);
      });
      historyList.appendChild(item);
    }
  }

  async function openHistory() {
    if (!historyModal) return;
    historyModal.classList.remove('hidden');
    try { renderHistory(await window.api.historyList()); } catch (_) {}
  }
  function closeHistory() {
    if (historyModal) historyModal.classList.add('hidden');
  }

  if (historyBtn) historyBtn.addEventListener('click', openHistory);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && historyModal && !historyModal.classList.contains('hidden')) closeHistory();
  });
  if (historyModal) {
    historyModal.addEventListener('click', (e) => { if (e.target === historyModal) closeHistory(); });
    const histClose = document.getElementById('historyCloseBtn');
    if (histClose) histClose.addEventListener('click', closeHistory);
    const histClear = document.getElementById('historyClearBtn');
    if (histClear) histClear.addEventListener('click', async () => {
      try {
        if (window.api.historyClear) { renderHistory(await window.api.historyClear()); toast('已清空下载历史', 'success'); }
      } catch (_) {}
    });
    const histOpenDir = document.getElementById('historyOpenDir');
    if (histOpenDir) histOpenDir.addEventListener('click', () => {
      if (window.api.openPath && state.saveDir) window.api.openPath(state.saveDir);
    });
  }

  // 每 5 分钟刷新源健康数据（死源恢复探测 + 速度更新）
  setInterval(() => {
    try { startupMovieHealthCheck(); } catch (_) {}
  }, 5 * 60 * 1000);
})();
