// 本地影视聚合服务状态条：启动时探测一次，进入影视面板时也刷新
async function refreshMovieApiStatus() {
  if (!els.movieApiStatus) return;
  try {
    const sv = await window.api.movieServerStatus();
    if (sv && sv.ok && sv.data && sv.data.code === 0) {
      els.movieApiStatus.classList.add('ok');
      els.movieApiStatus.classList.remove('err');
      els.movieApiStatus.querySelector('.movie-api-text').textContent =
        `本地聚合服务运行中 · 端口 ${sv.data.port} · 数据源 ${sv.data.sources} 个 · 缓存 ${sv.data.cacheEntries} 条`;
    } else {
      els.movieApiStatus.classList.remove('ok');
      els.movieApiStatus.classList.add('err');
      els.movieApiStatus.querySelector('.movie-api-text').textContent = '本地聚合服务未就绪（搜索将走直连多源）';
    }
  } catch (e) {
    els.movieApiStatus.classList.remove('ok');
    els.movieApiStatus.classList.add('err');
    els.movieApiStatus.querySelector('.movie-api-text').textContent = '本地聚合服务异常：' + e.message;
  }
}
refreshMovieApiStatus();

// 解析线路：手动切换 + 自动兜底（iframe 长时间无法加载时自动换下一条）
if (els.movieParserSwitchBtn) {
  els.movieParserSwitchBtn.addEventListener('click', () => {
    if (!playState.url) return;
    switchToNextParser();
  });
}
let parserFailTimer = null;
els.moviePlayer.addEventListener('load', () => {
  playState._iframeLoaded = true;
  clearTimeout(parserFailTimer);
  // 解析页加载后 1s 自动点击"立即播放"按钮（比等 2s 探测更快）
  setTimeout(() => { try { window.api.movieAutoPlayBtn(); } catch (_) {} }, 1000);
  parserFailTimer = setTimeout(() => {
    if (els.movieParserSwitchBtn) els.movieParserSwitchBtn.disabled = false;
  }, 12000);
});
// 每次换解析/换集时启动兜底：8s 内 iframe 连 load 都没触发 → 自动换下一条解析（或换源）
function armParserFailTimer() {
  clearTimeout(parserFailTimer);
  parserFailTimer = setTimeout(() => {
    if (!playState.url) return;
    if (playState._iframeLoaded) return;   // 页面已加载但无视频，交给探测逻辑处理
    playState.deadSince = 0;   // 重置防抖，确保这次兜底一定生效
    tryAutoSwitch(true);
  }, 8000);
}
armParserFailTimer();

