  if (!audio) return;
  switch (action) {
    case 'play':
    case 'pause':
      if (audio.paused) audio.play().catch(() => {});
      else audio.pause();
      break;
    case 'next':
      playNextInQueue();
      break;
    case 'prev':
      playPrevInQueue();
      break;
  }
});

// ===== 收藏歌曲 =====
const likedSongs = new Set(JSON.parse(localStorage.getItem('likedSongs') || '[]'));
function saveLikedSongs() { localStorage.setItem('likedSongs', JSON.stringify([...likedSongs])); }
function updateLikeButton() {
  if (!els.musicLikeCur) return;
  const songId = MUSIC.cur && MUSIC.cur.song ? MUSIC.cur.song.id : null;
  const liked = songId != null && likedSongs.has(String(songId));
  els.musicLikeCur.classList.toggle('on', liked);
  els.musicLikeCur.title = liked ? '取消收藏' : '收藏';
}
if (els.musicLikeCur) {
  els.musicLikeCur.addEventListener('click', async () => {
    if (!MUSIC.cur || !MUSIC.cur.song) { toast('请先播放一首歌曲', 'error'); return; }
    const songId = String(MUSIC.cur.song.id);
    const songName = MUSIC.cur.song.name || '未知歌曲';
    const wasLiked = likedSongs.has(songId);
    // 乐观更新 UI
    if (wasLiked) likedSongs.delete(songId); else likedSongs.add(songId);
    saveLikedSongs();
    updateLikeButton();
    // 调用 API 同步到云端
    const r = await window.api.musicLike(songId);
    if (r && r.ok) {
      toast(wasLiked ? `已取消收藏「${songName}」` : `已收藏「${songName}」`, 'success', 2000);
    } else {
      // 失败则回滚
      if (wasLiked) likedSongs.add(songId); else likedSongs.delete(songId);
      saveLikedSongs();
      updateLikeButton();
      toast('操作失败：' + ((r && r.error) || '请检查登录状态'), 'error', 3000);
    }
  });
}

// ===== 歌词面板拖拽 =====
(function initLyricsDrag() {
  const header = document.querySelector('.lyrics-header');
  const panel = els.lyricsPanel;
  if (!header || !panel) return;
  let dragging = false, startX, startY, startLeft, startTop;
  header.addEventListener('mousedown', (e) => {
    if (e.target.closest('button')) return;
    dragging = true;
    state.lyricsDragging = true;
    const rect = panel.getBoundingClientRect();
    startX = e.clientX; startY = e.clientY;
    startLeft = rect.left; startTop = rect.top;
    panel.style.transition = 'none';
    e.preventDefault();
  });
  document.addEventListener('mousemove', (e) => {
    if (!dragging) return;
    const dx = e.clientX - startX, dy = e.clientY - startY;
    let newLeft = startLeft + dx, newTop = startTop + dy;
    newLeft = Math.max(0, Math.min(newLeft, window.innerWidth - panel.offsetWidth));
    newTop = Math.max(0, Math.min(newTop, window.innerHeight - panel.offsetHeight));
    panel.style.left = newLeft + 'px';
    panel.style.top = newTop + 'px';
    panel.style.right = 'auto';
    panel.style.bottom = 'auto';
  });
  document.addEventListener('mouseup', () => {
    if (dragging) {
      dragging = false;
      state.lyricsDragging = false;
      panel.style.transition = '';
    }
  });
})();

