// ============================================
// UC 网盘分享解析
// ============================================
let UC_LAST_SHARE = null;

async function doUcParse() {
  const raw = els.ucUrlInput.value.trim();
  if (!raw) { toast('请输入 UC 网盘分享链接', 'error'); return; }
  // 提取链接
  const m = raw.match(/https?:\/\/[^\s"'<>，。；、]+/i);
  const url = m ? m[0].replace(/[，。；、,.;:'")]+$/g, '') : raw;
  if (!/^https?:\/\/.*drive\.uc\.cn\//i.test(url)) {
    toast('请输入有效的 UC 网盘链接（如 https://drive.uc.cn/s/xxxxxxxx）', 'error', 4000);
    return;
  }
  showLoading('正在解析 UC 分享页…');
  let r;
  try {
    r = await window.api.parseUc(url);
  } finally {
    hideLoading();
  }
  if (!r.ok) {
    toast('解析失败：' + r.error, 'error', 4000);
    els.ucShareMeta.classList.add('hidden');
    els.ucFileList.innerHTML = '';
    UC_LAST_SHARE = null;
    return;
  }
  UC_LAST_SHARE = r.data;
  renderUcShare(r.data);
  toast(`已检测到 ${r.data.files.length} 个文件`, 'success');
}

function renderUcShare(data) {
  els.ucShareMeta.classList.remove('hidden');
  els.ucAuthorName.textContent = data.author || '匿名用户';
  els.ucShareTitle.textContent = data.shareTitle || '—';
  els.ucFileNum.textContent = data.fileNum || data.files.length;
  els.ucExpire.textContent = formatUcExpire(data.expiredAt, data.expiredType);

  // 头像（可能 http，先转 https）
  if (data.avatar) {
    els.ucAuthorAvatar.src = data.avatar.replace(/^http:/, 'https:');
    els.ucAuthorAvatar.style.display = '';
  } else {
    els.ucAuthorAvatar.style.display = 'none';
  }

  els.ucFileList.innerHTML = '';
  if (!data.files.length) {
    els.ucFileList.innerHTML = '<div class="empty-state small"><p>该分享里没有文件</p></div>';
    return;
  }

  data.files.forEach((f, idx) => {
    const row = document.createElement('div');
    row.className = 'uc-file-row';
    const ext = (f.format || (f.name.match(/\.([^.]+)$/) || [])[1] || '?').toUpperCase();
    const size = f.size ? formatBytes(f.size) : '—';
    const date = f.updatedAt ? new Date(f.updatedAt).toLocaleString('zh-CN') : '';
    row.innerHTML = `
      <div class="uc-file-icon">${escapeHtml(ext)}</div>
      <div class="uc-file-main">
        <div class="uc-file-name" title="${escapeHtml(f.name)}">${escapeHtml(f.name)}</div>
        <div class="uc-file-meta">
          <span>${size}</span>
          ${date ? `<span>·</span><span>${date}</span>` : ''}
          ${f.dir ? '<span class="uc-file-tag tag-dir">文件夹</span>' : ''}
          ${f.shareFidToken ? '' : '<span class="uc-file-tag tag-warn">无 token（可能需登录）</span>'}
        </div>
      </div>
      <div class="uc-file-actions">
        <button class="btn-action btn-video btn-sm" data-act="open" data-i="${idx}">打开分享页</button>
        <button class="btn-ghost btn-sm" data-act="copy" data-i="${idx}">复制链接</button>
      </div>
    `;
    els.ucFileList.appendChild(row);
  });

  els.ucFileList.querySelectorAll('button[data-act=open]').forEach(b => {
    b.addEventListener('click', () => {
      const f = data.files[+b.dataset.i];
      const link = buildUcFileLink(data, f);
      window.api.openUcShare(link);
      toast('已打开分享页（可在浏览器中下载 / 保存到网盘）', 'success');
    });
  });
  els.ucFileList.querySelectorAll('button[data-act=copy]').forEach(b => {
    b.addEventListener('click', () => {
      const f = data.files[+b.dataset.i];
      const link = buildUcFileLink(data, f);
      navigator.clipboard.writeText(link).then(() => toast('已复制文件分享链接', 'success')).catch(() => toast('复制失败', 'error'));
    });
  });
}

function buildUcFileLink(data, file) {
  // 直接打开根分享页 + hash 定位单个文件；UC 网页会滚动到对应行
  let url = data.shareUrl || ('https://drive.uc.cn/s/' + data.pwdId + '?public=1');
  if (data.passcode) {
    url += (url.includes('?') ? '&' : '?') + 'pwd=' + encodeURIComponent(data.passcode);
  }
  // 加 hash 触发分享详情路由
  url += '#/list/share';
  return url;
}

function formatUcExpire(expiredAt, expiredType) {
  if (expiredType === 1 || !expiredAt) return '永久';
  try {
    const d = new Date(expiredAt);
    return d.toLocaleString('zh-CN');
  } catch (_) { return '—'; }
}

function formatBytes(n) {
  if (!n) return '0 B';
  const u = ['B', 'KB', 'MB', 'GB', 'TB'];
  let i = 0;
  while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
  return (i === 0 ? n : n.toFixed(1)) + ' ' + u[i];
}

if (els.ucParseBtn) els.ucParseBtn.addEventListener('click', doUcParse);
if (els.ucUrlInput) els.ucUrlInput.addEventListener('keydown', e => { if (e.key === 'Enter') doUcParse(); });
if (els.ucOpenShareBtn) els.ucOpenShareBtn.addEventListener('click', () => {
  if (!UC_LAST_SHARE) { toast('请先粘贴并检测分享链接', 'error'); return; }
  window.api.openUcShare(UC_LAST_SHARE.shareUrl);
  toast('已打开分享页', 'success');
});

