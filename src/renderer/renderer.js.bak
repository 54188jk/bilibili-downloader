  'https://www.iqiyizy.com/api.php/provide/vod/',        // 爱奇艺资源（~2.2s）
  'https://cj.lziapi.com/api.php/provide/vod',           // 量子资源（~2.2s）
];
const MOVIE_PARSER_PRESETS = [
  // ── 一线解析（2026-09 实测通过，按速度/稳定性排序） ──
  'https://video.isyour.love/player/getplayer?url=',       // 邦宁云（101ms，直接返回视频URL，最快）
  'https://yparse.ik9.cc/index.php?url=',                  // 自解析（推荐，最健壮 26KB）
  'https://jx.m3u8.pw/?url=',                             // M3U8解析（29KB，大站稳定）
  'https://jx.xmflv.cc/?url=',                            // 虾米解析（10KB）
  'https://jx.xymp4.cc/?url=',                            // 咸鱼云解析（19KB）
  'https://www.playm3u8.cn/jiexi.php?url=',               // playm3u8（528ms，老牌稳定）
  'https://www.ckplayer.vip/jiexi/?url=',                 // CK解析（545ms）
  'http://aikan-tv.com/?url=',                            // 爱看（21KB）
  'https://www.pangujiexi.com/pangu/?url=',               // 盘古解析（1KB）
