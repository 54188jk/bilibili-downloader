    const parser = els.movieParserInput.value.trim();
    if (base && !/^https?:\/\//i.test(base)) { toast('搜索源需以 http(s):// 开头', 'error'); return; }
    if (parser && !/^https?:\/\//i.test(parser)) { toast('解析接口需以 http(s):// 开头', 'error'); return; }
    localStorage.setItem('movieBase', base);
    localStorage.setItem('movieParser', parser);
    const timeoutSec = parseInt(els.movieProbeTimeoutInput?.value, 10);
    if (Number.isFinite(timeoutSec) && timeoutSec >= 1 && timeoutSec <= 30) {
      localStorage.setItem('movieProbeTimeout', String(timeoutSec * 1000));
    }
    els.movieSettings.classList.add('hidden');
    toast('数据源已保存', 'success');
  });
}
